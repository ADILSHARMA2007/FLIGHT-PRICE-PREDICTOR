# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Data files (large)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model files (large)
models/*.pkl
models/*.joblib
!models/.gitkeep

# Outputs
outputs/plots/*
outputs/predictions/*
!outputs/plots/.gitkeep
!outputs/predictions/.gitkeep
